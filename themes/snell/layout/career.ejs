<% var intro = (theme.career && theme.career.intro) ? markdown(theme.career.intro) : page.content; %>
<section class="sn-listing">
  <%- partial('_partial/page-head', { eyebrow: '', title: __('nav.career'), lead: intro }) %>
  <div class="sn-rows">
    <% snell_jobs().forEach(function (j) { %><%- partial('_partial/job-row', { item: j }) %><% }) %>
  </div>
  <ul class="sn-tags sn-career-tags" aria-label="<%= __('labels.tagged') %>">
    <% snell_job_tags().forEach(function (tag) { %><li><a class="sn-tag" href="<%- url_for(tag.path) %>"><%= tag.name %></a></li><% }) %>
  </ul>
</section>
