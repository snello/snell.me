<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= snell_page_title() %></title>
  <% var desc = page.description || (page.job_title ? page.company + ', ' + page.job_title : '') || config.description || config.subtitle; %>
  <% if (desc) { %><meta name="description" content="<%= desc %>"><% } %>
  <meta name="author" content="<%= config.author %>">
  <meta property="og:title" content="<%= snell_page_title() %>">
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:url" content="<%= config.url %>/<%= page.path ? page.path.replace(/index\.html$/, '') : '' %>">
  <% if (desc) { %><meta property="og:description" content="<%= desc %>"><% } %>
  <meta name="theme-color" content="#ffffff">
  <%
    var fav = theme.favicon || {};
    var hash = (theme.gravatar && theme.gravatar.hash) || '';
    function favUrl (f, size) { if (!f) return ''; return (f.gravatar && hash) ? 'https://www.gravatar.com/avatar/' + hash + '?s=' + size : url_for(f.url); }
  %>
  <% if (fav.desktop) { %><link rel="icon" href="<%= favUrl(fav.desktop, 64) %>"><% } %>
  <% if (fav.apple) { %><link rel="apple-touch-icon" href="<%= favUrl(fav.apple, 180) %>"><% } %>
  <link rel="preload" href="<%- url_for('/fonts/DMSans-Variable.woff2') %>" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%- url_for('/css/tokens.css') %>">
  <link rel="stylesheet" href="<%- url_for('/css/theme.css') %>">
  <% if (config.feed && config.feed.path) { %><link rel="alternate" type="application/atom+xml" href="<%- url_for(config.feed.path) %>" title="<%= config.title %>"><% } %>
</head>
