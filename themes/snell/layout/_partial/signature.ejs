    <a class="sn-signature-arrow" href="#top" aria-label="<%= __('labels.top') %>"><%- snell_icon('arrow-up-right', 22) %></a>
  </div>
  <p class="sn-signature-name" aria-hidden="true"><%= theme.signature_name || theme.name %></p>
</footer>
