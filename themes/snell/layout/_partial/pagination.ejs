<% if (page.total > 1) { %>
<nav class="sn-pagination" aria-label="Pages">
  <% if (page.prev) { %><a class="sn-btn sn-btn-pill" href="<%- url_for(page.prev_link) %>"><span class="sn-dot"></span><%= __('labels.previous') %></a><% } %>
  <span class="sn-eyebrow"><%= page.current %> / <%= page.total %></span>
  <% if (page.next) { %><a class="sn-btn sn-btn-pill" href="<%- url_for(page.next_link) %>"><span class="sn-dot"></span><%= __('labels.next') %></a><% } %>
</nav>
<% } %>
